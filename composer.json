{
    "name": "migears/mitable",
    "description": "Minimalist single-table execution helper for one-off data migrations — DDL, CRUD, introspection, and cursor-based iteration in one class.",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "database",
        "table",
        "ddl",
        "crud",
        "migration",
        "pdo",
        "migears"
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "suggest": {
        "ext-pdo_mysql": "For MySQL/MariaDB DDL operations",
        "ext-pdo_sqlite": "For SQLite (testing and simple use cases)"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\MiTable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\MiTable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
